---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articles from '../../data/articles.json';

const guideArticles = articles.filter(a => a.category === '新手入门' || a.category === '客户端教程' || a.category === '避坑指南' || a.category === '选购指南');

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '新手指南', url: '/guides/' }
];
---

<BaseLayout
  title="新手指南与科学上网使用教程大全｜机场精选"
  description="为刚接触机场与科学上网的新手用户打造的保姆级指南：从零基础选购第一款套餐，到Windows、Mac、iOS、Android多端客户端下载与配置教学。"
  canonicalUrl="https://jichang-jingxuan.blog/guides/"
  breadcrumbs={breadcrumbs}
>
  <div class="container" style="padding-top: 40px; padding-bottom: 80px;">
    <nav class="breadcrumb-nav">
      <a href="/">首页</a>
      <span>&gt;</span>
      <span style="color: var(--color-primary); font-weight: 700;">新手指南</span>
    </nav>

    <header style="max-width: 860px; margin: 0 auto 40px auto; text-align: center;">
      <div class="section-eyebrow">BEGINNER ROADMAP</div>
      <h1 class="section-title">2026 科学上网新手入门与配置指南</h1>
      <p class="section-subtitle" style="margin: 0 auto 24px auto;">
        告别网络小白的焦虑。带你一步步理解机场原理、掌握客户端安全连接，远离黑卡超售与高危扣费陷阱。
      </p>
    </header>

    <!-- 4-step Visual Workflow -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 50px;">
      <div class="faq-card" style="padding: 24px; text-align: center;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-gold); color: #101D35; font-weight: 900; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">1</div>
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-primary); margin-bottom: 8px;">了解需求选品牌</h3>
        <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6;">明确每月用量，查阅本站精选榜单与品牌详情页。</p>
      </div>

      <div class="faq-card" style="padding: 24px; text-align: center;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-gold); color: #101D35; font-weight: 900; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">2</div>
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-primary); margin-bottom: 8px;">先月付低成本试水</h3>
        <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6;">首月选择 15–20 元月付套餐，利用折扣码立减。</p>
      </div>

      <div class="faq-card" style="padding: 24px; text-align: center;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-gold); color: #101D35; font-weight: 900; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">3</div>
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-primary); margin-bottom: 8px;">下载对应客户端</h3>
        <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6;">官方客户端或 Clash Verge / Nextin 一键导入。</p>
      </div>

      <div class="faq-card" style="padding: 24px; text-align: center;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-gold); color: #101D35; font-weight: 900; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">4</div>
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-primary); margin-bottom: 8px;">晚高峰实测体验</h3>
        <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6;">在晚上 20:00–23:00 验证稳定性，再决定长久方案。</p>
      </div>
    </div>

    <!-- Related Articles -->
    <div style="margin-bottom: 40px;">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary); margin-bottom: 24px;">
        新手必读精选教程与避坑文章
      </h2>
      <div class="articles-grid">
        {guideArticles.map(art => (
          <article class="article-card">
            <div class="article-card-cover">
              <img
                src={art.cover || `/images/articles/${art.slug}.jpg`}
                alt={art.title}
                loading="lazy"
                decoding="async"
                class="article-cover-img"
              />
              <div class="article-cover-overlay"></div>
              <span class="article-cover-badge">{art.category}</span>
            </div>
            <div class="article-card-body">
              <div class="article-meta-row">
                <span>{art.date}</span>
                <span>•</span>
                <span>{art.readTime}</span>
              </div>
              <h3 class="article-card-title">
                <a href={`/articles/${art.slug}/`} style="color: var(--color-primary);">
                  {art.title}
                </a>
              </h3>
              <p class="article-card-excerpt">
                {art.excerpt}
              </p>
              <div style="margin-top: auto; padding-top: 16px;">
                <a href={`/articles/${art.slug}/`} class="article-read-btn">
                  <span>阅读教程</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
