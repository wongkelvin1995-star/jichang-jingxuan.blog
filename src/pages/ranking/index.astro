---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandCard from '../../components/BrandCard.astro';
import brands from '../../data/brands.json';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '精选榜单', url: '/ranking/' }
];
---

<BaseLayout
  title="2026机场排行榜 - 18个精选机场品牌综合排名与选购指南｜机场精选"
  description="2026年精选机场综合排行榜：严格按照站长指定与编辑推荐评估标准，对灵动云、暮光加速、微风网络等18个品牌从专线质量、套餐性价比、客户端支持等多维度综合排序展示。"
  canonicalUrl="https://jichang-jingxuan.blog/ranking/"
  breadcrumbs={breadcrumbs}
>
  <div class="container" style="padding-top: 40px; padding-bottom: 80px;">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav" aria-label="面包屑路径导航">
      <a href="/">首页</a>
      <span>&gt;</span>
      <span style="color: var(--color-primary); font-weight: 700;">精选榜单</span>
    </nav>

    <!-- Header Intro -->
    <div style="text-align: center; max-width: 800px; margin: 0 auto 50px auto;">
      <div class="section-eyebrow">EDITORIAL RANKINGS · 2026</div>
      <h1 class="section-title">2026 机场精选排行榜</h1>
      <p class="section-subtitle" style="margin: 0 auto 24px auto;">
        本榜单属于编辑推荐展示顺序，依据公开套餐价格、线路类型、计费倍率、多端兼容性及服务稳定性综合排布。FLYV 与浪网并列第六。
      </p>
      <div style="display: inline-flex; gap: 12px; font-size: 0.85rem; color: var(--color-text-muted); background: var(--color-gold-light); padding: 8px 18px; border-radius: 30px;">
        <span>ℹ️ 排名依据公开资料评估</span>
        <span>•</span>
        <a href="/methodology/" style="color: #7A5B20; font-weight: 700; text-decoration: underline;">查看榜单精选标准与方法论</a>
      </div>
    </div>

    <!-- Ranking Table Summary -->
    <div class="table-outer-wrapper" style="margin-bottom: 50px;">
      <div style="padding: 16px 24px; background: #F8F6F0; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; font-weight: 700; color: var(--color-primary);">
        精选品牌总览一览表
      </div>
      <div class="table-scroll-container">
        <table class="plan-table">
          <thead>
            <tr>
              <th>推荐排名</th>
              <th>品牌名称</th>
              <th>主打线路</th>
              <th>起步月付</th>
              <th>起步年付</th>
              <th>在售套餐</th>
              <th style="text-align: right;">品牌详情与购买</th>
            </tr>
          </thead>
          <tbody>
            {brands.map(b => (
              <tr>
                <td>
                  <span class={`rank-badge ${b.rank === 1 ? 'top1' : ''}`}>
                    {b.rank <= 3 ? `TOP 0${b.rank}` : `NO. 0${b.rank}`}
                  </span>
                </td>
                <td class="plan-name-cell">
                  <a href={`/airports/${b.slug}/`} style="color: var(--color-primary); text-decoration: underline;">
                    {b.name}
                  </a>
                </td>
                <td>{b.lineType}</td>
                <td class="plan-price-cell">
                  {b.minMonthlyPrice ? `¥${b.minMonthlyPrice}/月` : '无单独月付'}
                </td>
                <td style="font-weight: 700; color: var(--color-gold);">
                  {b.minYearlyPrice ? `¥${b.minYearlyPrice}/年` : '-'}
                </td>
                <td>{b.plans.length} 档</td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 8px;">
                    <a href={`/airports/${b.slug}/`} class="btn btn-outline btn-sm">
                      详情
                    </a>
                    <a href={b.purchaseUrl} target="_blank" rel="sponsored nofollow noopener" class="btn btn-primary btn-sm">
                      购买
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Detailed Brand Cards in Rank Order -->
    <div style="margin-bottom: 30px;">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary); margin-bottom: 20px;">
        上榜品牌卡片深度展示
      </h2>
      <div class="brands-grid">
        {brands.map(b => (
          <BrandCard brand={b} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
