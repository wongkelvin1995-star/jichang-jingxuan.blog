---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articles from '../../data/articles.json';
import brands from '../../data/brands.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  return articles.map((art, idx) => ({
    params: { slug: art.slug },
    props: {
      article: art,
      prevArticle: idx > 0 ? articles[idx - 1] : null,
      nextArticle: idx < articles.length - 1 ? articles[idx + 1] : null
    }
  }));
}

const { article, prevArticle, nextArticle } = Astro.props;

// Read raw markdown file to get content body
const mdPath = path.resolve(`src/content/articles/${article.slug}.md`);
const mdRaw = fs.readFileSync(mdPath, 'utf8');

// Simple markdown to HTML converter for prose
function renderMarkdown(raw: string): string {
  // strip frontmatter
  let body = raw.replace(/^---[\s\S]*?---\n/, '');

  // Handle alerts
  body = body.replace(/> \[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\] ([^\n]+)/g, (_match, type, text) => {
    return `<div class="article-alert ${type.toLowerCase()}"><div class="alert-type">${type}</div><p>${text}</p></div>`;
  });

  // Handle tables
  const lines = body.split('\n');
  let inTable = false;
  let tableLines: string[] = [];
  let htmlLines: string[] = [];

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line.trim().startsWith('|') && line.trim().endsWith('|')) {
      if (!inTable) {
        inTable = true;
        tableLines = [];
      }
      tableLines.push(line);
    } else {
      if (inTable) {
        inTable = false;
        // render table
        if (tableLines.length >= 2) {
          const headers = tableLines[0].split('|').map(s => s.trim()).filter(Boolean);
          const dataRows = tableLines.slice(2);
          let tableHtml = `<div class="table-outer-wrapper" style="margin: 24px 0;"><div class="table-scroll-container"><table class="plan-table"><thead><tr>`;
          headers.forEach(h => { tableHtml += `<th>${h}</th>`; });
          tableHtml += `</tr></thead><tbody>`;
          dataRows.forEach(row => {
            const cols = row.split('|').map(s => s.trim());
            if (cols[0] === '') cols.shift();
            if (cols[cols.length - 1] === '') cols.pop();
            if (cols.length > 0) {
              tableHtml += `<tr>`;
              cols.forEach(c => {
                // handle inline link
                const formatted = c.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" style="color: var(--color-gold); font-weight: 700; text-decoration: underline;">$1</a>');
                tableHtml += `<td>${formatted}</td>`;
              });
              tableHtml += `</tr>`;
            }
          });
          tableHtml += `</tbody></table></div></div>`;
          htmlLines.push(tableHtml);
        }
      }

      // Handle normal markdown
      let processed = line;
      if (processed.startsWith('### ')) {
        processed = `<h3>${processed.slice(4)}</h3>`;
      } else if (processed.startsWith('## ')) {
        const titleText = processed.slice(3);
        const id = titleText.replace(/[\s\(\)\/\#]+/g, '-').toLowerCase();
        processed = `<h2 id="${id}">${titleText}</h2>`;
      } else if (processed.startsWith('# ')) {
        processed = `<h1>${processed.slice(2)}</h1>`;
      } else if (processed.startsWith('- ')) {
        const itemText = processed.slice(2)
          .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" style="color: var(--color-gold); text-decoration: underline;">$1</a>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        processed = `<li>${itemText}</li>`;
      } else if (processed.startsWith('> ')) {
        processed = `<blockquote>${processed.slice(2)}</blockquote>`;
      } else if (processed.trim() === '---') {
        processed = `<hr style="margin: 40px 0; border: none; border-top: 1px solid var(--color-border);" />`;
      } else if (processed.trim().length > 0 && !processed.startsWith('<')) {
        const pText = processed
          .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" style="color: var(--color-gold); text-decoration: underline;">$1</a>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        processed = `<p>${pText}</p>`;
      }
      htmlLines.push(processed);
    }
  }

  return htmlLines.join('\n');
}

const articleHtml = renderMarkdown(mdRaw);

// Related articles
const relatedArticles = articles
  .filter(a => a.id !== article.id && (a.category === article.category || Math.random() > 0.5))
  .slice(0, 3);

// Related brands
const matchedBrands = brands.filter(b => article.relatedBrands.includes(b.slug));

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '精选文章', url: '/articles/' },
  { name: article.title, url: `/articles/${article.slug}/` }
];

const articleSchema = {
  '@type': 'BlogPosting',
  'headline': article.title,
  'description': article.excerpt,
  'author': {
    '@type': 'Organization',
    'name': article.author
  },
  'datePublished': article.date,
  'dateModified': article.updatedDate,
  'mainEntityOfPage': `https://jichang-jingxuan.blog/articles/${article.slug}/`
};
---

<BaseLayout
  title={`${article.title}｜机场精选`}
  description={article.excerpt}
  canonicalUrl={`https://jichang-jingxuan.blog/articles/${article.slug}/`}
  breadcrumbs={breadcrumbs}
  schema={articleSchema}
  ogType="article"
>
  <div class="article-reader-container">
    <!-- Breadcrumb Nav -->
    <nav class="breadcrumb-nav">
      <a href="/">首页</a>
      <span>&gt;</span>
      <a href="/articles/">精选文章</a>
      <span>&gt;</span>
      <span style="color: var(--color-primary); font-weight: 700;">{article.category}</span>
    </nav>

    <!-- Article Header -->
    <header style="margin-bottom: 36px;">
      <div style="display: inline-block; font-size: 0.8rem; font-weight: 800; color: var(--color-gold); background: var(--color-gold-light); padding: 4px 14px; border-radius: 20px; margin-bottom: 16px;">
        {article.category}
      </div>

      <h1 class="article-main-title">
        {article.title}
      </h1>

      <div class="article-author-bar">
        <span>作者：{article.author}</span>
        <span>•</span>
        <span>发布日期：{article.date}</span>
        <span>•</span>
        <span>更新日期：{article.updatedDate}</span>
        <span>•</span>
        <span>预计阅读：{article.readTime}</span>
      </div>

      <!-- Lead / Excerpt -->
      <div style="background: var(--color-card-bg); border-left: 4px solid var(--color-gold); padding: 20px 24px; border-radius: 0 var(--radius-md) var(--radius-md) 0; border: 1px solid var(--color-border); border-left-width: 4px; font-size: 1.05rem; color: var(--color-text-main); line-height: 1.8; margin-bottom: 24px;">
        <strong>导读：</strong>{article.excerpt}
      </div>

      <!-- Article Featured Cover Image -->
      <div class="article-featured-hero">
        <img
          src={article.cover || `/images/articles/${article.slug}.jpg`}
          alt={article.title}
          class="article-featured-img"
          loading="eager"
          decoding="async"
        />
      </div>
    </header>

    <!-- Main Article Prose -->
    <article class="article-prose" set:html={articleHtml} />

    <!-- Mentioned Brands Cards In-Article -->
    {matchedBrands.length > 0 && (
      <div style="margin: 50px 0; padding: 28px; background: var(--color-card-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
        <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--color-primary); margin-bottom: 16px;">
          本文提及的精选品牌与通道
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          {matchedBrands.map(b => (
            <div style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 18px; background: var(--color-bg); display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="font-size: 0.8rem; color: var(--color-gold); font-weight: 800; margin-bottom: 4px;">NO. 0{b.rank} · {b.lineType}</div>
                <h4 style="font-size: 1.15rem; font-weight: 800; color: var(--color-primary); margin-bottom: 6px;">{b.name}</h4>
                <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: 12px;">{b.tagline}</p>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-subtle); padding-top: 10px;">
                <span style="font-size: 0.9rem; font-weight: 800; color: var(--color-primary);">{b.minMonthlyPrice ? `¥${b.minMonthlyPrice}/月起` : '在售多档'}</span>
                <a href={`/airports/${b.slug}/`} style="font-size: 0.82rem; font-weight: 700; color: var(--color-gold); text-decoration: underline;">查看品牌 &gt;</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Prev & Next Article Navigation -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 50px 0; padding: 24px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
      <div>
        {prevArticle ? (
          <div>
            <div style="font-size: 0.78rem; color: var(--color-text-muted); margin-bottom: 4px;">← 上一篇</div>
            <a href={`/articles/${prevArticle.slug}/`} style="font-size: 0.95rem; font-weight: 700; color: var(--color-primary); line-height: 1.4;">
              {prevArticle.title}
            </a>
          </div>
        ) : (
          <span style="font-size: 0.85rem; color: var(--color-text-muted);">已是第一篇</span>
        )}
      </div>

      <div style="text-align: right;">
        {nextArticle ? (
          <div>
            <div style="font-size: 0.78rem; color: var(--color-text-muted); margin-bottom: 4px;">下一篇 →</div>
            <a href={`/articles/${nextArticle.slug}/`} style="font-size: 0.95rem; font-weight: 700; color: var(--color-primary); line-height: 1.4;">
              {nextArticle.title}
            </a>
          </div>
        ) : (
          <span style="font-size: 0.85rem; color: var(--color-text-muted);">已是最新篇</span>
        )}
      </div>
    </div>

    <!-- Related Articles -->
    <div style="margin-bottom: 50px;">
      <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--color-primary); margin-bottom: 20px;">
        延伸阅读与相关文章
      </h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px;">
        {relatedArticles.map(rel => (
          <a href={`/articles/${rel.slug}/`} class="faq-card" style="padding: 20px; transition: all 0.2s ease;">
            <div style="font-size: 0.75rem; color: var(--color-gold); font-weight: 700; margin-bottom: 6px;">{rel.category}</div>
            <h4 style="font-size: 1.05rem; font-weight: 800; color: var(--color-primary); line-height: 1.4; margin-bottom: 8px;">
              {rel.title}
            </h4>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6;">
              {rel.excerpt.slice(0, 50)}...
            </p>
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Action Buttons -->
    <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
      <a href="/articles/" class="btn btn-outline">
        <span>返回文章列表 (30)</span>
      </a>
      <a href="/airports/" class="btn btn-primary">
        <span>浏览机场品牌大全</span>
      </a>
      <a href="/ranking/" class="btn btn-gold">
        <span>精选排行榜</span>
      </a>
    </div>
  </div>
</BaseLayout>
