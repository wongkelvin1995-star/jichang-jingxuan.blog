---
import BaseLayout from '../../layouts/BaseLayout.astro';
import brands from '../../data/brands.json';
import seoDescriptions from '../../data/brand-seo-descriptions.json';

export async function getStaticPaths() {
  return brands.map(brand => ({
    params: { slug: brand.slug },
    props: { brand }
  }));
}

const { brand } = Astro.props;

// Compute 3-4 related brands (excluding self)
const relatedBrands = brands
  .filter(b => b.slug !== brand.slug)
  .slice(0, 3);

// Generate brand-specific FAQ questions based on real data
const brandFaqs = [
  {
    q: `${brand.name}最低套餐价格是多少？有哪些付款周期？`,
    a: `${brand.name}目前的起步月付套餐为 ${brand.minMonthlyPrice ? `¥${brand.minMonthlyPrice}/月` : '以实际在售档位为准'}，${brand.minYearlyPrice ? `年付起步价格为 ¥${brand.minYearlyPrice}/年` : '部分套餐未设单独年付'}。在售套餐共有 ${brand.plans.length} 档，覆盖${brand.hasLifetimePlans ? '月付、年付及一次性买断不限时流量包' : '常规月付、季付与年付长周期'}。`
  },
  {
    q: `${brand.name}支持 Clash 和第三方客户端订阅导入吗？`,
    a: `${brand.name}的第三方客户端政策为：${brand.clientSupport.clash}。若使用官方客户端，Windows、macOS 与 Android 可直接通过账号登录自动同步节点，iOS 用户推荐查看官方指南按指定客户端（如 Nextin 等）配置。`
  },
  {
    q: `${brand.name}的线路类型是什么？晚高峰表现如何？`,
    a: `该品牌线路主要采用 ${brand.lineType}，协议主要支持 ${brand.protocols}。节点覆盖地区包括 ${brand.regions}。品牌宣传不限速或 1x 统一倍率，但晚高峰吞吐量与稳定性仍会受用户本地运营商出口负载波动影响，建议购买后在晚高峰（20:00-23:00）针对常用节点进行实际体验。`
  },
  {
    q: `${brand.name}能否正常访问 ChatGPT、Claude 与流媒体？`,
    a: `根据品牌公开服务说明：${brand.streamingAi.chatgpt}；流媒体方面：${brand.streamingAi.netflix}。需要注意的是，由于海外流媒体与 AI 平台对数据中心 IP 实行动态风控检测，没有任何机场能承诺 100% 永久全节点解锁，遇访问受阻可切换不同地区节点重试。`
  },
  {
    q: `${brand.name}目前有优惠券或折扣码可以使用吗？`,
    a: brand.coupons && brand.coupons.length > 0
      ? `目前记录到有效优惠券码为：${brand.coupons.map(c => `【${c.code}】（享受${c.discount}，${c.note}）`).join('；')}。请在官网结算页优惠券输入框填写并确认折扣生效后再付款。`
      : `目前该品牌未公开发行常态化全场折扣码，其套餐定价本身已按周期设置了阶梯优惠（如年付相较月付折算单月成本更低），后续若有官方节日活动我们将第一时间同步更新。`
  },
  {
    q: `${brand.name}套餐流量用完后如何处理？`,
    a: `周期套餐的月度流量按约 30 天周期自动重置，月内未用完的流量不顺延结转。若当月流量提前耗尽，通常可登录用户中心购买同档流量重置包，或根据需要升级至更高流量档位。低频或应急用户亦可考虑其提供的不限时流量包方案。`
  }
];

const seoTitle = brand.seoTitle || `${brand.name}机场怎么样？2026套餐价格、节点与购买指南｜机场精选`;
// Hand-written SEO descriptions (70–110 chars) live in brand-seo-descriptions.json;
// the generated string below only serves as a fallback for brands without one.
const metaDesc = (seoDescriptions as Record<string, string>)[brand.slug]
  || `${brand.name}详细介绍：${brand.tagline}，最低月付¥${brand.minMonthlyPrice || '详见正文'}起，共${brand.plans.length}档套餐，附价格与流量对比及客户端选购指南。`;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场品牌', url: '/airports/' },
  { name: brand.name, url: `/airports/${brand.slug}/` }
];

const articleSchema = {
  '@type': 'WebPage',
  'name': seoTitle,
  'description': metaDesc,
  'url': `https://jichang-jingxuan.blog/airports/${brand.slug}/`,
  'dateModified': '2026-11-24',
  'datePublished': '2026-11-20'
};
---

<BaseLayout
  title={seoTitle}
  description={metaDesc}
  canonicalUrl={`https://jichang-jingxuan.blog/airports/${brand.slug}/`}
  breadcrumbs={breadcrumbs}
  schema={articleSchema}
>
  <div class="container" style="padding-top: 40px; padding-bottom: 80px;">
    <!-- Breadcrumb Nav -->
    <nav class="breadcrumb-nav" aria-label="面包屑路径导航">
      <a href="/">首页</a>
      <span>&gt;</span>
      <a href="/airports/">机场品牌大全</a>
      <span>&gt;</span>
      <span style="color: var(--color-primary); font-weight: 700;">{brand.name}</span>
    </nav>

    <!-- 第一部分：品牌介绍 Header Hero -->
    <header style="background: var(--color-card-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 36px 40px; margin-bottom: 40px; box-shadow: var(--shadow-sm);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 18px;">
          <div style="width: 64px; height: 64px; border-radius: 16px; background: var(--color-primary); color: var(--color-gold); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; font-weight: 900; border: 2px solid var(--color-gold); box-shadow: 0 4px 16px rgba(16,29,53,0.15);">
            {brand.name.slice(0, 1)}
          </div>
          <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
              <span class={`rank-badge ${brand.rank === 1 ? 'top1' : ''}`} style="font-size: 0.85rem; padding: 4px 12px;">
                编辑推荐排名 NO. 0{brand.rank}
              </span>
              <span style="font-size: 0.82rem; color: var(--color-text-muted);">{brand.lineType}</span>
            </div>
            <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 900; color: var(--color-primary); line-height: 1.2;">
              {brand.name}
            </h1>
          </div>
        </div>

        <div style="display: flex; gap: 12px; align-items: center;">
          <a href={brand.purchaseUrl} target="_blank" rel="sponsored nofollow noopener" class="btn btn-gold btn-lg">
            <span>访问官网 / 前往购买</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <p style="font-size: 1.12rem; color: var(--color-text-main); line-height: 1.8; margin-bottom: 24px; max-width: 960px;">
        {brand.description || brand.tagline}
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; background: var(--color-bg); padding: 18px 24px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
        <div>
          <span style="font-size: 0.8rem; color: var(--color-text-muted);">常规月付起步</span>
          <div style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary);">
            {brand.minMonthlyPrice ? `¥${brand.minMonthlyPrice}` : '无月付'} <span style="font-size: 0.85rem; font-weight: normal; color: var(--color-text-muted);">{brand.minMonthlyPrice ? '/ 月' : ''}</span>
          </div>
        </div>
        <div>
          <span style="font-size: 0.8rem; color: var(--color-text-muted);">超值年付起步</span>
          <div style="font-size: 1.45rem; font-weight: 800; color: var(--color-gold);">
            {brand.minYearlyPrice ? `¥${brand.minYearlyPrice}` : '无年付'} <span style="font-size: 0.85rem; font-weight: normal; color: var(--color-text-muted);">{brand.minYearlyPrice ? '/ 年' : ''}</span>
          </div>
        </div>
        <div>
          <span style="font-size: 0.8rem; color: var(--color-text-muted);">在售规格总数</span>
          <div style="font-size: 1.45rem; font-weight: 800; color: var(--color-text-main);">
            {brand.plans.length} 档套餐
          </div>
        </div>
        <div>
          <span style="font-size: 0.8rem; color: var(--color-text-muted);">资料核实日期</span>
          <div style="font-size: 1.15rem; font-weight: 700; color: var(--color-text-muted); padding-top: 4px;">
            {brand.recordedAt}
          </div>
        </div>
      </div>
    </header>

    <div style="display: grid; grid-template-columns: 1fr; gap: 40px; max-width: 1080px; margin: 0 auto;">
      
      <!-- 第二部分：品牌定位 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 16px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          品牌定位与服务特征
        </h2>
        <p style="font-size: 1.02rem; line-height: 1.8; color: var(--color-text-main); margin-bottom: 16px;">
          {brand.positioning || `${brand.name}定位为兼顾稳定性与性价比的实用型网络加速平台。品牌主要聚焦于常用流媒体影音播放、AI 生产力工具访问、跨国外贸查件及日常高频科学上网需求。通过梯次合理的套餐规格划分，为轻度办公用户与重度下载玩家提供差异化的连接支持。`}
        </p>
        <p style="font-size: 0.98rem; line-height: 1.8; color: var(--color-text-muted);">
          目标受众分析：{brand.targetAudience || '适合预算敏感型学生群体、需要多设备同时在线的家庭工作室、跨境电商运营人员以及偶尔需要备用梯子的低频网络用户。'}
        </p>
      </section>

      <!-- 第三部分：全部套餐与价格 (完整展示对应 MD 中的所有套餐) -->
      <section class="faq-card" style="padding: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
          <div>
            <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); border-left: 4px solid var(--color-gold); padding-left: 12px; margin-bottom: 6px;">
              全部在售套餐与价格明细 ({brand.plans.length} 档)
            </h2>
            <p style="font-size: 0.9rem; color: var(--color-text-muted);">
              完整保留对应 Markdown 资料中的所有套餐记录与可用周期，原价与优惠期均如实记录。
            </p>
          </div>
          <span style="font-size: 0.82rem; color: #8F723B; background: var(--color-gold-light); padding: 4px 12px; border-radius: 20px;">
            全节点统一 1.0x 倍率
          </span>
        </div>

        <div class="table-outer-wrapper" style="margin-top: 16px;">
          <div class="table-scroll-container">
            <table class="plan-table">
              <thead>
                <tr>
                  <th>套餐名称</th>
                  <th>付款周期</th>
                  <th>单次价格</th>
                  <th>月度折算</th>
                  <th>流量配额</th>
                  <th>设备与速率</th>
                  <th style="text-align: right;">订购链接</th>
                </tr>
              </thead>
              <tbody>
                {brand.plans.map(p => (
                  <tr>
                    <td class="plan-name-cell">{p.planName}</td>
                    <td><span class="feature-pill">{p.cycle}</span></td>
                    <td class="plan-price-cell">{p.priceRaw}</td>
                    <td style="font-size: 0.88rem; color: var(--color-text-muted);">
                      {p.monthlyEquivalent ? `¥${p.monthlyEquivalent}/月` : '-'}
                    </td>
                    <td><strong>{p.traffic}</strong></td>
                    <td style="font-size: 0.85rem; color: var(--color-text-muted);">
                      <div>{p.devices}</div>
                      <div>{p.speedLimit}</div>
                    </td>
                    <td style="text-align: right;">
                      <a href={brand.purchaseUrl} target="_blank" rel="sponsored nofollow noopener" class="btn btn-primary btn-sm" style="padding: 6px 14px;">
                        前往选购
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 第四部分：套餐选择建议 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 16px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          套餐选购分析与预算建议
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
          <div style="background: var(--color-bg); padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
            <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--color-primary); margin-bottom: 8px;">入门尝鲜型</h3>
            <p style="font-size: 0.92rem; color: var(--color-text-main); line-height: 1.7;">
              若初次接触该品牌，建议优先选择最低档月付规格（约 {brand.minMonthlyPrice ? `¥${brand.minMonthlyPrice}` : '基础档'}）。以最低成本在晚高峰实测当地网络的连通延迟与稳定性，满意后再考虑更长周期。
            </p>
          </div>
          <div style="background: var(--color-bg); padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
            <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--color-primary); margin-bottom: 8px;">主力长效型</h3>
            <p style="font-size: 0.92rem; color: var(--color-text-main); line-height: 1.7;">
              对于长期有外贸办公或海外查阅需求的用户，年付套餐通常可享受 8 折左右的阶梯折扣，折合每月成本仅数元至十几元，性价比较高。
            </p>
          </div>
          <div style="background: var(--color-bg); padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
            <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--color-primary); margin-bottom: 8px;">高频大流量型</h3>
            <p style="font-size: 0.92rem; color: var(--color-text-main); line-height: 1.7;">
              4K 视频重度追剧或多设备共享用户，建议挑选 300GB 以上规格，避免中途流量耗尽触发重置包额外开支。
            </p>
          </div>
        </div>
      </section>

      <!-- 第五部分：节点地区与协议 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 16px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          节点地区与网络协议说明
        </h2>
        <div style="display: flex; flex-direction: column; gap: 14px; font-size: 0.98rem; line-height: 1.8;">
          <div>
            <strong>覆盖国家与地区：</strong>
            <span>{brand.regions}</span>
          </div>
          <div>
            <strong>线路架构类型：</strong>
            <span>{brand.lineType}</span>
          </div>
          <div>
            <strong>支持传输协议：</strong>
            <span>{brand.protocols}</span>
          </div>
          <div style="background: #F6F4EE; padding: 14px 18px; border-radius: var(--radius-sm); border-left: 3px solid var(--color-gold); font-size: 0.88rem; color: var(--color-text-muted);">
            客观说明：以上节点地区及线路参数依据品牌公开运营文档整理。实际节点在线数量及出口延迟可能随服务商运维、网络割接与国际海缆拥堵产生动态变化。
          </div>
        </div>
      </section>

      <!-- 第六部分：设备与客户端兼容性 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 16px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          设备与客户端兼容性规范
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 20px;">
          <div style="border: 1px solid var(--color-border); padding: 16px; border-radius: var(--radius-sm);">
            <div style="font-weight: 700; color: var(--color-primary); margin-bottom: 6px;">Windows 客户端</div>
            <div style="font-size: 0.88rem; color: var(--color-text-main);">{brand.clientSupport.windows}</div>
          </div>
          <div style="border: 1px solid var(--color-border); padding: 16px; border-radius: var(--radius-sm);">
            <div style="font-weight: 700; color: var(--color-primary); margin-bottom: 6px;">macOS 客户端</div>
            <div style="font-size: 0.88rem; color: var(--color-text-main);">{brand.clientSupport.macOS}</div>
          </div>
          <div style="border: 1px solid var(--color-border); padding: 16px; border-radius: var(--radius-sm);">
            <div style="font-weight: 700; color: var(--color-primary); margin-bottom: 6px;">Android 安卓</div>
            <div style="font-size: 0.88rem; color: var(--color-text-main);">{brand.clientSupport.android}</div>
          </div>
          <div style="border: 1px solid var(--color-border); padding: 16px; border-radius: var(--radius-sm);">
            <div style="font-weight: 700; color: var(--color-primary); margin-bottom: 6px;">iOS 苹果设备</div>
            <div style="font-size: 0.88rem; color: var(--color-text-main);">{brand.clientSupport.ios}</div>
          </div>
        </div>
        <div style="background: var(--color-bg); padding: 16px 20px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-size: 0.92rem;">
          <strong>Clash 及第三方订阅规则：</strong>
          <span style="color: var(--color-text-main);">{brand.clientSupport.clash}</span>
        </div>
      </section>

      <!-- 第七部分：AI及流媒体使用场景 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 16px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          AI 与流媒体场景可用性说明
        </h2>
        <div style="display: flex; flex-direction: column; gap: 12px; font-size: 0.95rem; line-height: 1.8;">
          <div><strong>Netflix 奈飞：</strong>{brand.streamingAi.netflix}</div>
          <div><strong>Disney+ 迪士尼：</strong>{brand.streamingAi.disney}</div>
          <div><strong>YouTube 4K：</strong>{brand.streamingAi.youtube}</div>
          <div><strong>ChatGPT 智能助手：</strong>{brand.streamingAi.chatgpt}</div>
          <div><strong>其他 AI 工具：</strong>{brand.streamingAi.otherAi}</div>
        </div>
        <div style="margin-top: 18px; font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6;">
          特别提醒：海外各平台对数据中心 IP 实行持续的风控规则迭代，上述能力为服务商公开标注支持的场景，不代表全节点 100% 永久有效承诺。
        </div>
      </section>

      <!-- 第八部分：品牌优势与不足 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 20px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          核心优势与使用局限客观评测
        </h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
          <div style="background: #F4F8F3; padding: 20px 24px; border-radius: var(--radius-md); border-left: 4px solid #388E3C;">
            <h3 style="font-size: 1.1rem; font-weight: 800; color: #1B5E20; margin-bottom: 12px;">主要优势</h3>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.92rem; color: #2E4032;">
              {brand.advantages ? brand.advantages.map(adv => (
                <li style="display: flex; align-items: flex-start; gap: 8px;">
                  <span style="color: #388E3C; font-weight: 900;">✓</span>
                  <span>{adv}</span>
                </li>
              )) : (
                <li>专线调度平稳，资费梯度适中</li>
              )}
            </ul>
          </div>

          <div style="background: #FBF6F4; padding: 20px 24px; border-radius: var(--radius-md); border-left: 4px solid #D32F2F;">
            <h3 style="font-size: 1.1rem; font-weight: 800; color: #B71C1C; margin-bottom: 12px;">使用局限与注意事项</h3>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.92rem; color: #44302E;">
              {brand.limitations ? brand.limitations.map(lim => (
                <li style="display: flex; align-items: flex-start; gap: 8px;">
                  <span style="color: #D32F2F; font-weight: 900;">⚠</span>
                  <span>{lim}</span>
                </li>
              )) : (
                <li>不提供无理由退款，请按需购买短期体验</li>
              )}
            </ul>
          </div>
        </div>
      </section>

      <!-- 第九部分：适合哪些用户 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 16px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          用户画像与选购场景建议
        </h2>
        <div style="font-size: 1rem; line-height: 1.85; color: var(--color-text-main);">
          <p style="margin-bottom: 12px;">
            综合线路特征与定价，<strong>{brand.name}</strong> 较为适合以下场景的用户：
          </p>
          <ul style="padding-left: 20px; display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px;">
            <li><strong>追求性价比与透明计费的用户：</strong>全节点统一 1.0 倍率计费，无隐形扣量陷阱。</li>
            <li><strong>希望简化客户端配置的新手：</strong>可借助官方客户端一键账号登录，省去自行维护 Clash 订阅规则的繁琐。</li>
            <li><strong>多端设备办公或家庭共享：</strong>{brand.plans[0]?.devices || '设备限制宽松'}，适合手机、电脑与平板同时连接。</li>
            <li><strong>低频备用者：</strong>若有长效小包或一次性流量需求，可锁定对应专线不限时规格。</li>
          </ul>
        </div>
      </section>

      <!-- 第十部分：优惠券及活动 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 16px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          最新优惠券与促销代码
        </h2>
        {brand.coupons && brand.coupons.length > 0 ? (
          <div style="display: flex; flex-direction: column; gap: 14px;">
            {brand.coupons.map(cp => (
              <div style="display: flex; justify-content: space-between; align-items: center; background: #FFFBF2; border: 1px dashed var(--color-gold); padding: 18px 24px; border-radius: var(--radius-md); flex-wrap: wrap; gap: 12px;">
                <div>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 1.35rem; font-weight: 900; color: #A67C26; letter-spacing: 0.05em; font-family: var(--font-mono);">
                      {cp.code}
                    </span>
                    <span class="rank-badge" style="background: var(--color-gold); color: #101D35;">
                      {cp.discount} 优惠
                    </span>
                  </div>
                  <div style="font-size: 0.88rem; color: var(--color-text-muted); margin-top: 4px;">
                    适用范围：{cp.note}
                  </div>
                </div>
                <a href={brand.purchaseUrl} target="_blank" rel="sponsored nofollow noopener" class="btn btn-gold btn-sm">
                  前往官网使用 →
                </a>
              </div>
            ))}
            <div style="font-size: 0.82rem; color: var(--color-text-muted);">
              注：优惠券有效期及适用套餐以官方结算页最终验证为准，核实记录日期：{brand.recordedAt}。
            </div>
          </div>
        ) : (
          <div style="background: var(--color-bg); padding: 20px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-size: 0.95rem; color: var(--color-text-muted);">
            该品牌目前暂无长期通用优惠码发放，套餐已内置阶梯折扣（年付相对于按月续费享有折扣优惠）。若有官方临时促销活动，本站将及时补充录入。
          </div>
        )}
      </section>

      <!-- 第十一部分：相关品牌推荐 -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 20px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          相关机场品牌推荐与对比
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px;">
          {relatedBrands.map(rb => (
            <div style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 20px; background: var(--color-bg); display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <span class="rank-badge">NO. 0{rb.rank}</span>
                  <span style="font-size: 0.75rem; color: var(--color-text-muted);">{rb.lineType}</span>
                </div>
                <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--color-primary); margin-bottom: 6px;">
                  {rb.name}
                </h3>
                <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: 16px;">
                  {rb.tagline}
                </p>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-subtle); padding-top: 12px;">
                <span style="font-size: 0.9rem; font-weight: 700; color: var(--color-primary);">
                  {rb.minMonthlyPrice ? `¥${rb.minMonthlyPrice}/月起` : '在售多档'}
                </span>
                <a href={`/airports/${rb.slug}/`} style="font-size: 0.85rem; font-weight: 700; color: var(--color-gold);">
                  对比详情 →
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 第十二部分：品牌专属 FAQ (5-8个定制问题) -->
      <section class="faq-card" style="padding: 32px;">
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--color-primary); margin-bottom: 20px; border-left: 4px solid var(--color-gold); padding-left: 12px;">
          {brand.name} 专属常见问题与使用疑惑 (FAQ)
        </h2>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          {brandFaqs.map((faq, idx) => (
            <div style="border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 16px;">
              <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--color-primary); margin-bottom: 8px; display: flex; align-items: baseline; gap: 8px;">
                <span style="color: var(--color-gold); font-size: 0.9rem;">Q{idx + 1}.</span>
                <span>{faq.q}</span>
              </h3>
              <p style="font-size: 0.95rem; color: var(--color-text-main); line-height: 1.75; padding-left: 28px;">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- 底部操作栏 -->
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; padding: 24px; background: var(--color-primary); border-radius: var(--radius-lg); color: #FFFFFF;">
        <div>
          <div style="font-size: 1.25rem; font-weight: 800; margin-bottom: 4px;">立即选购 {brand.name} 服务</div>
          <div style="font-size: 0.85rem; color: #BAC2D0;">访问官方结账中心，直达最新在售套餐与优惠通道</div>
        </div>
        <div style="display: flex; gap: 12px;">
          <a href="/airports/" class="btn btn-outline" style="border-color: rgba(255,255,255,0.3); color: #FFFFFF;">
            返回品牌大全
          </a>
          <a href={brand.purchaseUrl} target="_blank" rel="sponsored nofollow noopener" class="btn btn-gold">
            前往官方购买 →
          </a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
