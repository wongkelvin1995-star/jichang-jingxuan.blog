---
const faqs = [
  {
    q: '机场精选是一个什么样的网站？',
    a: '机场精选（Airport Select）是一个专注于机场品牌介绍、套餐价格对比、性价比分析与选购指南的专业中立内容平台。我们系统化整理各品牌的公开资料、价格档位、客户端兼容性及使用场景，帮助用户依据自身预算与实际需求做出理性决策。本站不是单一机场官网，不虚构测速跑分，亦不提供虚假的绝对稳定性承诺。'
  },
  {
    q: '2026年应该如何选择适合自己的机场？',
    a: '选择机场首要看使用场景与预算：轻度查阅文档与社交，每月 100GB 以内的平价月付或年付小包即能满足；若有 4K 追剧、Steam 下载或重度 AI 交互需求，应优先考虑 IEPL/IPLC 专线与大流量方案。建议首次使用任何新品牌均先选择一个月周期进行晚高峰实际体验，确认本地网络适配良好后再考虑长周期。'
  },
  {
    q: '便宜机场和高端机场有什么区别？',
    a: '便宜机场与高端机场的核心差异通常体现在线路架构、出口带宽成本与冗余机制上。便宜机场多采用普通公网中转或直连，高峰期可能出现拥堵或延迟升高；高端机场多采购成本高昂的 IEPL/IPLC 专线，并配备多入口 BGP 智能调度与多机房容灾，在网络敏感时期具备更平稳的表现与更充裕的单用户带宽。'
  },
  {
    q: '机场月付和年付套餐应该怎么选择？',
    a: '原则上强烈建议“新手首月月付，稳定后再订年付”。月付能最大程度降低试错成本，防止遇到线路与本地宽带不匹配的情况；年付通常享有 75 折至 85 折的明显价格优惠，折算单月成本极具吸引力。若品牌运营时间较长、口碑平稳且自身预算明确，选择年付是更经济的方案；低频备用用户则可关注不限时流量包。'
  },
  {
    q: '如何判断一个机场是否适合长期使用？',
    a: '判断机场可否长期使用，应重点考察其工单客服响应时效、节点线路冗余能力、计费倍率是否透明（如全节点统一 1.0 倍率）、以及是否具备清晰的使用文档与客户端指引。此外，拥有多条独立专线、不盲目进行夸张无限速宣传、且运营周期稳定的品牌，通常在网络复杂波动时具有更高的存续度与服务韧性。'
  },
  {
    q: '机场套餐流量用完后怎么办？',
    a: '常规周期套餐的流量按自然月或 30 天周期重置，未用完的流量不结转至下月。若月内流量提前耗尽，大部分品牌支持在后台购买同档流量重置包（价格通常等同于该套餐月付价）或直接补订一次性流量包以应急。重度流量消耗者在选购之初应预留 20%–30% 的用量冗余，或选择 300GB 以上的进阶规格。'
  },
  {
    q: '所有机场都支持 Clash 和第三方客户端吗？',
    a: '并非所有机场都默认开放第三方 Clash 订阅。部分品牌出于防止节点配置泄露与防盗刷考虑，仅提供官方封装客户端（如 Windows、macOS 专属软件或 iOS Nextin 授权接入）；部分品牌则仅对破晓、凌霄等高阶套餐用户开放工单申请第三方订阅链接。购买前务必查阅本站品牌详情页中的“客户端与设备兼容性”说明。'
  },
  {
    q: '如何选择适合 AI 工具及流媒体的机场？',
    a: '访问 ChatGPT、Claude 等 AI 工具以及 Netflix、Disney+ 等流媒体服务，关键取决于节点出口 IP 的纯净度与目标平台的地区风控策略。选择时应关注品牌是否标明支持流媒体解锁与原生 IP 路由，并优先挑选新加坡、日本、台湾、美国等常用出口。由于各流媒体平台风控动态调整，没有任何机场能够提供 100% 永久解锁保证。'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(item => ({
    '@type': 'Question',
    'name': item.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.a
    }
  }))
};
---

<section class="section" style="border-top: 1px solid var(--color-border);">
  <div class="container">
    <div style="text-align: center; margin-bottom: 40px;">
      <div class="section-eyebrow">FREQUENTLY ASKED QUESTIONS</div>
      <h2 class="section-title">机场精选常见问题</h2>
      <p class="section-subtitle" style="margin: 0 auto;">
        梳理新手与资深用户在挑选机场、评估稳定性、计费周期与客户端配置时最关心的 8 个高频问题。
      </p>
    </div>

    <div class="faq-grid">
      {faqs.map((item, idx) => (
        <article class="faq-card">
          <h3 class="faq-question">
            <span class="faq-q-badge">0{idx + 1}</span>
            <span>{item.q}</span>
          </h3>
          <p class="faq-answer">
            {item.a}
          </p>
        </article>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
